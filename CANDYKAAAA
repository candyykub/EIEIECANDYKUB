----------------------------------------------------------------
-- Shape helpers
----------------------------------------------------------------
local function arc(cx, cy, r, a0, a1)
    return function(u)
        local a = a0 + (a1 - a0) * u
        return cx + math.cos(a) * r, cy + math.sin(a) * r
    end
end

local function poly(pts, closed)
    local segs, total = {}, 0
    local count = closed and #pts or #pts - 1
    for k = 1, count do
        local a, b = pts[k], pts[k % #pts + 1]
        local len = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)
        table.insert(segs, { a, b, len })
        total += len
    end
    return function(u)
        local d = u * total
        for _, s in ipairs(segs) do
            if d <= s[3] then
                local f = s[3] > 0 and d / s[3] or 0
                return s[1][1] + (s[2][1] - s[1][1]) * f, s[1][2] + (s[2][2] - s[1][2]) * f
            end
            d -= s[3]
        end
        local last = segs[#segs][2]
        return last[1], last[2]
    end
end

local function line(x1, y1, x2, y2)
    return poly({ { x1, y1 }, { x2, y2 } }, false)
end

local function shapePoint(shape, i, n, flow)
    local total = 0
    for _, s in ipairs(shape) do
        total += s[1]
    end
    local u = (((i - 1) / n + (flow or 0)) % 1) * total
    for _, s in ipairs(shape) do
        if u < s[1] then
            return s[2](u / s[1])
        end
        u -= s[1]
    end
    return shape[#shape][2](1)
end

local function rot2(x, y, a)
    local c, s = math.cos(a), math.sin(a)
    return x * c - y * s, x * s + y * c
end

local function front(hrp, x, y, dist, height)
    return hrp.CFrame * CFrame.new(x, (height or 8) + y, -(dist or 15))
end

