-- Spread / distance layout (skipped for raw modes)
----------------------------------------------------------------
local function applyLayout(cfs, n, hrp)
    local sp, ds = state.spread, state.dist
    if sp == 1 and ds == 0 then
        return
    end
    local hp = hrp.Position
    local sum, cnt = V3(), 0
    for i = 1, n do
        if cfs[i] then
            sum += cfs[i].Position - hp
            cnt += 1
        end
    end
    if cnt == 0 then
        return
    end
    local C = sum / cnt
    local Ch = V3(C.X, 0, C.Z)
    local centered = Ch.Magnitude < 3
    local push = centered and V3() or Ch.Unit * ds
    for i = 1, n do
        local cf = cfs[i]
        if cf then
            local rel = C + (cf.Position - hp - C) * sp + push
            if centered and ds ~= 0 then
                local h = V3(rel.X, 0, rel.Z)
                local mag = h.Magnitude
                if mag > 0.01 then
                    rel += h.Unit * math.max(ds, 1 - mag)
                end
            end
            cfs[i] = cf.Rotation + (hp + rel)
        end
    end
end

