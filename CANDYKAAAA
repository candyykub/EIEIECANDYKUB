local function getRootPart()
    local char = player.Character
    if not char then
        return nil
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not hrp then
        return nil
    end
    return hrp
end

local function findAllTargets()
    local root = workspace:FindFirstChild(CONFIG.RootName)
    if not root then
        return nil, "\u{E44}\u{E21}\u{E48}\u{E1E}\u{E1A} workspace." .. CONFIG.RootName
    end
    local folder = root:FindFirstChild(CONFIG.FolderName)
    if not folder then
        return nil, "\u{E44}\u{E21}\u{E48}\u{E1E}\u{E1A}\u{E42}\u{E1F}\u{E25}\u{E40}\u{E14}\u{E2D}\u{E23}\u{E4C} " .. CONFIG.FolderName
    end
    local list = {}
    for i, child in ipairs(folder:GetChildren()) do
        if child.Name == CONFIG.PropName then
            local remote = child:FindFirstChild(CONFIG.RemoteName)
            if remote and remote:IsA("RemoteFunction") then
                table.insert(list, { index = i, remote = remote })
            end
        end
    end
    if #list == 0 then
        return nil, "\u{E44}\u{E21}\u{E48}\u{E1E}\u{E1A} \"" .. CONFIG.PropName .. "\" \u{E17}\u{E35}\u{E48}\u{E21}\u{E35} " .. CONFIG.RemoteName
    end
    return list
end

local entryCache = setmetatable({}, { __mode = "k" })

local function rescan()
    local list, err = findAllTargets()
    if not list then
        state.targets = {}
        return false, err
    end
    local out = {}
    for _, t in ipairs(list) do
        local e = entryCache[t.remote] or { remote = t.remote, inFlight = false, sentAt = 0 }
        e.index = t.index
        entryCache[t.remote] = e
        table.insert(out, e)
    end
    state.targets = out
    return true
end

local function sendCFrame(entry, cf)
    local now = os.clock()
    if entry.inFlight and now - entry.sentAt < CONFIG.InvokeTimeout then
        return
    end
    entry.inFlight = true
    entry.sentAt = now
    task.spawn(function()
        pcall(entry.remote.InvokeServer, entry.remote, cf)
        entry.inFlight = false
    end)
end

