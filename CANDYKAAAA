-- Helpers for modes 15-35
----------------------------------------------------------------
local mouse = player:GetMouse()

local function aimPoint(hrp)
    local root = workspace:FindFirstChild(CONFIG.RootName)
    if root then
        mouse.TargetFilter = root
    end
    local hit = mouse.Hit
    if hit and (hit.Position - hrp.Position).Magnitude < 300 then
        return hit.Position
    end
    return (hrp.CFrame * CFrame.new(0, -3, -25)).Position
end

local function cyc(i, t, period, seed)
    return ((t + rand(i, seed) * period) % period) / period
end

local function flat(hrp)
    local lv = hrp.CFrame.LookVector
    local d = V3(lv.X, 0, lv.Z)
    if d.Magnitude < 0.01 then
        d = V3(0, 0, -1)
    end
    return CFrame.lookAt(hrp.Position, hrp.Position + d)
end

local function streak(a, b, p, spin)
    local pos = a:Lerp(b, p)
    return CFrame.lookAt(pos, pos + (b - a)) * CFrame.Angles(0, 0, spin or 0)
end

local function impact(start, land, p, i, t, spread)
    if p < 0.8 then
        return streak(start, land, (p / 0.8) ^ 2, t * 8)
    end
    local f = (p - 0.8) / 0.2
    local a = rand(i, 40) * TAU
    local sp = spread or 6
    return CFrame.new(land + V3(math.cos(a) * f * sp, math.sin(f * math.pi) * 4, math.sin(a) * f * sp)) * CFrame.Angles(f * 6, a, 0)
end

