-- Hello Kitty face drawn with frames (60x60 design grid)
local function makeKitty(parent, size, pos, zBase)
    local z = zBase or 2
    local box = new("Frame", { Size = UDim2.fromOffset(size, size), Position = pos, BackgroundTransparency = 1, ZIndex = z, Parent = parent })
    local s = size / 60
    local line = math.max(1, 2 * s)
    local function oval(x, y, w, h, color, zi, rot, rad, outline, transparent)
        local f = new("Frame", {
            Position = UDim2.fromOffset(x * s, y * s), Size = UDim2.fromOffset(w * s, h * s),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = color or T.white, BackgroundTransparency = transparent and 1 or 0,
            Rotation = rot or 0, BorderSizePixel = 0, ZIndex = z + zi, Parent = box,
        })
        corner(rad or UDim.new(0.5, 0)).Parent = f
        if outline then
            new("UIStroke", { Color = T.ink, Thickness = outline == true and line or outline * s, Parent = f })
        end
        return f
    end
    -- ears (behind head)
    oval(15, 18, 16, 16, T.white, 1, 30, UDim.new(0.25, 0), true)
    oval(45, 18, 16, 16, T.white, 1, -30, UDim.new(0.25, 0), true)
    -- head (wide oval)
    oval(30, 35, 52, 38, T.white, 2, 0, UDim.new(0.5, 0), true)
    -- eyes (tall ovals)
    oval(20, 37, 4, 6, T.ink, 3)
    oval(40, 37, 4, 6, T.ink, 3)
    -- nose
    oval(30, 42, 6, 4, T.nose, 3, 0, UDim.new(0.5, 0), 1.2)
    -- whiskers (3 each side)
    for k = -1, 1 do
        oval(4, 37 + k * 5, 12, 2, T.ink, 4, k * 12, UDim.new(0.5, 0))
        oval(56, 37 + k * 5, 12, 2, T.ink, 4, -k * 12, UDim.new(0.5, 0))
    end
    -- bow on right ear
    oval(39, 16, 13, 15, T.bow, 4, -35, UDim.new(0.5, 0), true)
    oval(53, 23, 13, 15, T.bow, 4, 35, UDim.new(0.5, 0), true)
    oval(39, 17, 5, 5, T.bow, 5, 0, UDim.new(0.5, 0), 1.3, true)
    oval(52, 22, 5, 5, T.bow, 5, 0, UDim.new(0.5, 0), 1.3, true)
    oval(46, 20, 9, 9, T.bow, 6, 0, UDim.new(0.5, 0), true)
    return box
end

