local sliderDrag = nil
local function makeSlider(parent, text, min, max, step, default, order, fmt, onChange)
    local row = new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
    new("TextLabel", {
        Text = text, Font = FONT, TextSize = 13, TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 0, 18), Parent = row,
    })
    local valLbl = new("TextLabel", {
        Text = "", Font = FONT, TextSize = 12, TextColor3 = T.white,
        BackgroundColor3 = T.hot, Size = UDim2.fromOffset(60, 18),
        Position = UDim2.new(1, -60, 0, 0), Parent = row,
    }, { corner(9) })
    local bar = new("Frame", {
        Size = UDim2.new(1, -10, 0, 10), Position = UDim2.fromOffset(5, 28),
        BackgroundColor3 = T.soft, Active = true, Parent = row,
    }, { corner(5) })
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.hot, BorderSizePixel = 0, Parent = bar }, { corner(5) })
    local knob = new("TextLabel", {
        Text = "\u{2665}", Font = FONT_TITLE, TextSize = 11, TextColor3 = T.hot,
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = T.white, Active = true, Parent = bar,
    }, { corner(10), stroke(T.hot, 2) })

    local obj = { value = default }
    local function apply(v, fire)
        v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
        local changed = v ~= obj.value
        obj.value = v
        local a = (v - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        valLbl.Text = fmt and fmt(v) or tostring(v)
        if fire and (changed or fire == "force") and onChange then
            onChange(v)
        end
    end
    function obj:fromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
        apply(min + (max - min) * a, true)
    end
    local function begin(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderDrag = obj
            tween(knob, 0.15, { Size = UDim2.fromOffset(24, 24) })
            obj:fromX(input.Position.X)
        end
    end
    function obj:release()
        tween(knob, 0.15, { Size = UDim2.fromOffset(20, 20) })
    end
    bind(bar.InputBegan, begin)
    bind(knob.InputBegan, begin)
    apply(default, "force")
    return obj
end

bind(UserInputService.InputChanged, function(input)
    if sliderDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        sliderDrag:fromX(input.Position.X)
    end
end)
bind(UserInputService.InputEnded, function(input)
    if sliderDrag and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        sliderDrag:release()
        sliderDrag = nil
    end
end)

