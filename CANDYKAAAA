local function setMode(i, silent)
    state.mode = i
    refreshModes()
    notify("\u{E42}\u{E2B}\u{E21}\u{E14}: " .. MODES[i].name, false, silent)
end

local function setRunning(on)
    if on then
        if not getRootPart() then
            notify("\u{E44}\u{E21}\u{E48}\u{E1E}\u{E1A}\u{E15}\u{E31}\u{E27}\u{E25}\u{E30}\u{E04}\u{E23}", true)
            refreshStatus()
            return false
        end
        local ok, err = rescan()
        if not ok then
            notify(err, true)
            refreshStatus()
            return false
        end
        state.lastScan = os.clock()
        state.running = true
        notify(("\u{E40}\u{E23}\u{E34}\u{E48}\u{E21} %s (%d \u{E2D}\u{E31}\u{E19})"):format(MODES[state.mode].name, #state.targets))
    else
        state.running = false
    end
    refreshStatus()
    return true
end

local function teleportOnce()
    local hrp = getRootPart()
    if not hrp then
        notify("\u{E44}\u{E21}\u{E48}\u{E1E}\u{E1A}\u{E15}\u{E31}\u{E27}\u{E25}\u{E30}\u{E04}\u{E23}", true)
        return
    end
    local list, err = findAllTargets()
    if not list then
        notify(err, true)
        return
    end
    local cf = hrp.CFrame
    local okCount, done = 0, 0
    for _, t in ipairs(list) do
        task.spawn(function()
            local s, res = pcall(t.remote.InvokeServer, t.remote, cf)
            if s and res ~= false then
                okCount += 1
            end
            done += 1
        end)
    end
    local t0 = os.clock()
    while done < #list and os.clock() - t0 < CONFIG.InvokeTimeout do
        task.wait()
    end
    notify(("\u{E14}\u{E36}\u{E07}\u{E21}\u{E32}\u{E17}\u{E35}\u{E48}\u{E15}\u{E31}\u{E27}\u{E2A}\u{E33}\u{E40}\u{E23}\u{E47}\u{E08} %d/%d \u{E2D}\u{E31}\u{E19}"):format(okCount, #list), okCount == 0)
end

