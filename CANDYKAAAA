----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
local clock, accum = 0, 0
local MAX_TRAIL = 400

heartbeatConn = RunService.Heartbeat:Connect(function(dt)
    local hrp = getRootPart()

    if hrp then
        local p = hrp.Position
        local last = state.trail[#state.trail]
        if not last or (p - last).Magnitude >= 1 then
            table.insert(state.trail, p)
            if #state.trail > MAX_TRAIL then
                table.remove(state.trail, 1)
            end
        end
    end

    if not state.running then
        return
    end
    clock += dt * state.speed
    accum += dt

    if state.auto then
        state.autoTimer += dt
        if state.autoTimer >= AUTO_TIME then
            state.autoTimer = 0
            setMode(state.mode % #MODES + 1)
        end
    end

    if accum < 1 / CONFIG.UpdateRate then
        return
    end
    accum = 0

    if not hrp then
        return
    end

    if os.clock() - state.lastScan > CONFIG.RescanInterval then
        state.lastScan = os.clock()
        rescan()
        refreshStatus()
    end

    local n = #state.targets
    if n == 0 then
        return
    end
    local mode = MODES[state.mode]
    local cfs = {}
    for i = 1, n do
        local ok, cf = pcall(mode.fn, i, n, clock, hrp)
        if ok and typeof(cf) == "CFrame" then
            cfs[i] = cf
        end
    end
    if not mode.raw then
        pcall(applyLayout, cfs, n, hrp)
    end
    for i, e in ipairs(state.targets) do
        if cfs[i] then
            sendCFrame(e, cfs[i])
        end
    end
end)

